# OSOVM server environment variables.
# Copy to .env (or /etc/osovm/env on the server) and fill in real values.

# REQUIRED: shared secret for server-to-server calls.
# Without this set, every authenticated route returns 401.
# Generate: openssl rand -hex 32
OSOVM_API_KEY=

# Optional: override default port (7780)
# OSOVM_PORT=7780

# Optional: comma-separated provider IDs on the mint allowlist.
# Empty = all providers eligible.
# OSOVM_ALLOWLIST=

# Optional: Zàngbétò review endpoint (enables real anchor verification).
# ZANGBETO_URL=http://localhost:4567
